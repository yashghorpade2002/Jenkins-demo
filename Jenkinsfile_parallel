pipeline{
    agent any
    stages {
        stage("CheckOut"){
            steps {
                sh 'echo "checking out the code repo"'
            }
        }
        stage("Build") {
            steps {
                sh 'echo "building out the code repo"'
            }
        }
        stage('Tests') {
            parallel{
                stage('Unit Tests') {
                    sh 'echo "starting unit tests"'
                }
                stage('Integration Test') {
                    sh 'echo "starting Integration tests"'
                }
            }
        }

    }

}