pipeline{
    agent any
    stages {
        stage("CheckOut"){
            steps {
                sh 'echo "checking out the code repo"'
            }
        }
        stage("Build") {
            steps {
                sh 'echo "building out the code repo"'
            }
        }
        stage("test") {
            steps {
                sh 'echo "testing out the code repo"'
            }
        }

    }

}